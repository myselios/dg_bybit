        "bollinger": {
          "long_condition": "price <= lower_band",
          "short_condition": "price >= upper_band",
          "score": 1,
          "period": 20, "std_dev": 2.0
        },
        "volume": {
          "condition": "current_volume > avg_volume_20",
          "score": 1,
