  "design_spec": {
    "ensemble_signal": {
      "description": "다중 지표 합산 점수 기반 진입 결정. LONG/SHORT 양방향.",
      "components": {
        "rsi": {
          "long_condition": "rsi < 35",
          "short_condition": "rsi > 65",
          "score": 2,
          "period": 14
        },
        "macd": {
          "long_condition": "macd bullish cross or hist 3연속 양수",
          "short_condition": "macd bearish cross or hist 3연속 음수",
          "score": 1,
          "fast": 12,
          "slow": 26,
          "signal": 9
        },
        "bollinger": {
          "long_condition": "price <= bb_lower * 1.003",
          "short_condition": "price >= bb_upper * 0.997",
          "score": 1,
          "period": 20,
          "std_dev": 2.0
        },
        "volume": {
          "condition": "current_volume > avg_volume_20",
          "score": 1,
          "description": "거래량 확인으로 신호 강도 증폭"
        },
        "ma_slope": {
          "existing": true,
          "description": "기존 T_TREND 동적 보정 유지",
          "score": 1
        },
        "breakout": {
          "long_condition": "price > 20캔들 최고가 + volume_multiplier",
          "short_condition": "price < 20캔들 최저가 + volume_multiplier",
          "score": 1,
          "period": 20,
          "vol_multiplier": 1.5
        }
      },
      "entry_threshold": 4,
      "max_score": 7
    },
    "kelly_sizing": {
      "description": "Kelly 분수로 공격적 포지션 사이징 (최대 25% 켈리)",
      "formula": "f = (win_rate * avg_win - loss_rate * avg_loss) / avg_win",
      "cap": 0.25,
      "fallback": "기존 loss_budget 방식 (win_rate 데이터 부족 시)"
    },
    "drawdown_recovery": {
      "description": "일일 손실 비율 기반 포지션 크기 조정 (Wave 5 Stream C)",
      "thresholds": {
        "normal": "loss < 50% of max_loss → size_multiplier=1.0",
        "reduce": "loss >= 50% → size_multiplier=0.7 (30% 축소)",
        "halt": "loss >= 80% → size_multiplier=0.0 (당일 거래 중단)"
      },
      "reset": "다음 날 0시 UTC 자동 복구"
    },
    "stage1_profit_config": {
      "leverage": 5,
      "max_trades_per_day": 15,
      "max_loss_usd_cap": 15.0,
